# Hermes Solana Bot v2 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Mode ─────────────────────────────────────────────
# paper = simulated trades, no real money
# live  = real swaps on-chain
# test  = unit test mode (mocked APIs)
BOT_MODE=paper

# ── Capital ────────────────────────────────────────────
BOT_CAPITAL_USD=90.78

# ── RPC Endpoints ────────────────────────────────────
# Primary: AllenHark staked RPC (best for tx submission)
RPC_PRIMARY_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# Fallback: Helius (free tier)
RPC_FALLBACK_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Last resort: public
RPC_PUBLIC_URL=https://api.mainnet-beta.solana.com

# ── API Keys ─────────────────────────────────────────
# Birdeye API (token discovery + holder data)
BIRDEYE_API_KEY=your_birdeye_api_key
BIRDEYE_API_URL=https://public-api.birdeye.so

# DexScreener (trending alerts — free, no key needed)
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex

# Jupiter v6
JUPITER_API_URL=https://api.jup.ag/swap/v6

# Jito bundle engine
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf/api/v1
JITO_AUTH_KEY=your_jito_auth_key

# ── Wallet ───────────────────────────────────────────
# Paper mode: dummy key (never used for real txs)
# Live mode: REAL private key — keep this file chmod 600
WALLET_PRIVATE_KEY_BASE58=your_base58_private_key
WALLET_PUBLIC_KEY=your_public_key

# ── Telegram Alerts ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=5786598754

# ── Safety Limits ────────────────────────────────────
DAILY_LOSS_LIMIT_USD=10.0
WEEKLY_LOSS_LIMIT_USD=20.0
MAX_DRAWDOWN_PCT=20.0
CONSECUTIVE_LOSS_HALT=3
RUG_HALT_THRESHOLD=2

# ── Position Sizing ──────────────────────────────────
BASE_POSITION_SIZE_USD=2.5
MAX_POSITION_SIZE_USD=5.0
MAX_POSITION_PCT_OF_CAPITAL=0.05

# ── Risk Gate ────────────────────────────────────────
MAX_RUG_SCORE=30
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=5000

# ── Copy-Trade ───────────────────────────────────────
COPY_WALLET_MIN_TRADES=500
COPY_WALLET_MIN_WIN_RATE=0.55
COPY_WALLET_MAX_DRAWDOWN_PCT=2.0
COPY_TRUST_LADDER=paper,0.5x,1.0x
COPY_MAX_WALLETS=5
COPY_MIRROR_TIMEOUT_SECONDS=30

# ── Tax / Compliance ─────────────────────────────────
TAX_EXPORT_DIR=state/tax
DEDICATED_WALLET_PUBLIC_KEY=your_public_key

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/hermes_v2.log
