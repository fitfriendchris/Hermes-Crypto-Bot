# CRYPTO BOT — NEW .env (CREATED 2026-05-11)
# NEVER commit this file to git — stores secrets
# Fill in your actual keys below. Lines starting with "# " are commented examples.

# ── MODE ──
# Set LIVE_MODE=true ONLY after wallet + cold address are both filled below.
LIVE_MODE=true

# ── TELEGRAM ALERTS ──
# BotFather token + chat ID
TELEGRAM_BOT_TOKEN=8282753636:AAFxI04RV9H0VYPpF_jHJlS40igTZQy5kdo
TELEGRAM_CHAT_ID=5786598754

# ═══════════════════════════════════════════════════════════════
# PROFIT SWEEPER (auto-move profits to cold storage)
# ═══════════════════════════════════════════════════════════════

# Mode: 'disabled' | 'paper_log' | 'sol' | 'usdc' | 'wbtc'
# Change to 'sol' once COLD_WALLET_SOL is filled in below.
PROFIT_SWEEP_MODE=sol

# Sweep when accumulated profit crosses this USD threshold
PROFIT_SWEEP_THRESHOLD=50.0

# Percentage of accumulated profit to sweep (0.0-1.0)
PROFIT_SWEEP_PCT=0.50

# Cold wallet address for Solana (your Ledger/Phantom cold address)
# COLD_WALLET_SOL=EZRNyQBEGJqb7dYmvkiEdMNDk9xATbbNcKZWDcs2YzEg

# Cold wallet address for Ethereum (your Ledger/MetaMask cold address)  
COLD_WALLET_ETH=0xD6e6C1b2FA74E8E968D59b118b362caa50564E0a
# ═══════════════════════════════════════════════════════════════
# WALLET KEYS — FILL THESE IN
# ═══════════════════════════════════════════════════════════════

# STEP 1 — Trading wallet private key (your FUNDED Exodus profile)
# In Exodus: click the SOL wallet → top-right "..." menu → "Export Private Key"
# Paste the long base58 string (starts with a number or letter, ~88 chars):
EXODUS_PRIVATE_KEY=3MxHpW6CuzLNNvWwbb8RPV7tAdUTwU3467ZUWaruVFX1zNXt4ZegUpEf4YKwL3wHUgriuSsCnbXQru3Wd7yNuQY3
# STEP 2 — Cold wallet receive address (your SECOND Exodus profile)
# In Exodus: open the second profile → SOL wallet → "Receive" → copy the address
# This is PUBLIC — safe to store here. The bot will sweep profits here.
COLD_WALLET_SOL=4q8EVi6Eg6uD39onYWqmfJu1aowgRJxGUe4WstK1Mgu9

# STEP 3 — Once both above are filled, change PROFIT_SWEEP_MODE to 'sol'
#   and set LIVE_MODE=true when you are ready to execute real trades.

# ── RPC ENDPOINTS (optional — falls back to public RPC if empty) ──
# Helius free tier: https://helius.xyz
# SOLANA_RPC_URL=your_helius_rpc
# ETH_RPC_URL=your_infura_or_alchemy_rpc

# ── PHANTOM WALLET (optional — Solana meme coins, 2nd Solana wallet) ──
# Export: Phantom app → Settings (⚙️) → Security & Privacy → Export Private Key → enter password
# Paste the base58 string below (58-88 chars). If set, PHANTOM key takes priority for swaps.
PHANTOM_PRIVATE_KEY=4GDnBFwJ3Y8bP7tX3aEZeLK4ZrBBXXMfk5MuaVpoiDFX5Y5syo9kcMTingMKhyLpJAmjSaR6n9AM62efhXn4qndz

