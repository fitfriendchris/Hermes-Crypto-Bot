# BTC Arbitrage Bot — Environment Configuration
# Copy to .env and fill in your keys

# Spot Exchange
ARB_SPOT_EXCHANGE=binance
ARB_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# Polymarket
POLY_API_KEY=your_polymarket_api_key
POLY_SECRET=your_polymarket_secret
POLY_PASSPHRASE=your_polymarket_passphrase
POLY_PRIVATE_KEY=0x_your_ethereum_private_key_for_signing

# Kalshi (optional secondary venue)
KALSHI_API_KEY=your_kalshi_api_key

# Risk Parameters
ARB_MAX_POSITION_USD=500
ARB_MAX_DAILY_LOSS_USD=100
ARB_MIN_EDGE_BPS=150
ARB_MAX_SLIPPAGE_BPS=50
ARB_USE_TESTNET=true
