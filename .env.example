# Crypto Bot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it stores private keys

# ── LIVE MODE ──
# Set to true for real DEX trading (requires wallet keys)
# Default: false = paper trading
LIVE_MODE=false

# ── WALLET KEYS (only needed for live mode) ──
# Exodus (recommended — 50+ chains, one key)
# Copy private key from Exodus: Wallet → (select coin) → ⋮ → Export Private Key
EXODUS_PRIVATE_KEY=

# Exodus seed phrase (alternative to private key — BIP39)
EXODUS_SEED_PHRASE=

# Legacy wallet options (still work if you prefer them)
# Solana / Phantom private key (base58)
PHANTOM_PRIVATE_KEY=

# Ethereum / BSC / MetaMask private key (hex with 0x)
METAMASK_PRIVATE_KEY=

# ── TELEGRAM ALERTS ──
# Create a bot via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── EXCHANGE KEYS (for majors via ccxt) ──
# Only needed if you trade BTC/ETH/XRP on Binance alongside DEX micro-caps
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── COLD STORAGE ADDRESSES ──
# Optional: profit protection will auto-transfer here
COLD_WALLET_SOL=
COLD_WALLET_ETH=
